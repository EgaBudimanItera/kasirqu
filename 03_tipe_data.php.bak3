<?php
// ============================================================
// Latihan 3 — Tipe Data
// Tujuan : mengenal jenis-jenis isi kotak (variabel).
// Buka   : http://localhost/smk4/kasirqu/03_tipe_data.php
//
// PHP otomatis tahu tipe data dari isinya. Tapi penting untuk
// paham bedanya, karena memengaruhi perhitungan & penulisan.
// ============================================================

$teks      = "Toko Maju Jaya";   // string  : kumpulan huruf/teks
$jumlah    = 20;                 // integer : bilangan bulat
$harga     = 3500.50;            // float   : bilangan desimal
$stok_ada  = true;               // boolean : benar / salah saja (true / false)
$produk    = ["Indomie", "Teh Pucuk", "Kopi",1]; // array: daftar banyak nilai
$produk1=array("Indomie","Teh Pucuk","Kopi",1);
$array_to =["produk"=>$produk,"harga"=>$harga,"jumlah"=>$jumlah];
var_dump($teks);
var_dump($jumlah);
var_dump($harga);
var_dump($stok_ada);
var_dump($produk);
var_dump($array_to);
var_dump($produk1);
?>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Latihan 3 — Tipe Data</title>
  <link rel="stylesheet" href="assets/style.css">
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <span class="brand">KasirQu <small>/ Toko Maju Jaya</small></span>
      <a class="back" href="index.php">&larr; Menu Latihan</a>
    </div>
  </header>

  <main class="wrap">
    <p class="tag">Latihan 3</p>
    <h1>Tipe Data: Jenis Isi Kotak</h1>
    <p class="lead">Setiap nilai punya "jenis". PHP bisa menebak jenisnya otomatis.</p>
    <?=var_dump($array_to); // menampilkan isi array secara lengkap?>
    <br>
    <?=var_dump($array_to["produk"][0]); // menampilkan isi array secara lengkap?>
    <table>
      <tr><th>Tipe</th><th>Contoh nilai</th><th>Isi variabel</th></tr>
      <tr><td>string</td><td>"Toko Maju Jaya"</td><td><?php echo $teks; ?></td></tr>
      <tr><td>integer</td><td>20</td><td><?php echo $jumlah; ?></td></tr>
      <tr><td>float</td><td>3500.50</td><td><?php echo $harga; ?></td></tr>
      <tr><td>boolean</td><td>true / false</td><td><?php echo $stok_ada ? "true (stok ada)" : "false (stok habis)"; ?></td></tr>
      <tr><td>array</td><td>["Indomie", "Teh Pucuk", "Kopi"]</td><td><?php echo implode(", ", $produk); ?></td></tr>
    </table>

    <div class="card">
      <h2>Array: Berindeks vs Asosiatif vs Bertingkat</h2>
      
      <p><strong>A) Array Berindeks (Indexed Array)</strong> - Diakses pakai nomor <code>0,1,2,...</code></p>
      <pre>&lt;?php
$buah = ["Apel", "Jeruk", "Mangga"];
echo $buah[0]; // Apel
?&gt;</pre>
      <p>Hasil: <?php echo $buah[0]; ?>, <?php echo $buah[1]; ?>, <?php echo $buah[2]; ?></p>

      <hr style="border:0;border-top:1px solid #E1E6EE;margin:16px 0;">

      <p><strong>B) Array Asosiatif (Associative Array)</strong> - Diakses pakai <strong>label/nama kunci</strong> buatan sendiri</p>
      <pre>&lt;?php
$produk = [
  "kode"  => "P01",
  "nama"  => "Mie Instan",
  "harga" => 3500
];
echo $produk["nama"]; // Mie Instan
?&gt;</pre>
      <?php $produk_b = ["kode"=>"P01","nama"=>"Mie Instan","harga"=>3500]; ?>
      <p>Hasil: Kode: <strong><?php echo $produk_b["kode"]; ?></strong> | Nama: <strong><?php echo $produk_b["nama"]; ?></strong> | Harga: <strong>Rp <?php echo $produk_b["harga"]; ?></strong></p>

      <hr style="border:0;border-top:1px solid #E1E6EE;margin:16px 0;">

      <p><strong>C) Array Bertingkat / Array of Arrays</strong> - <em>"Daftar produk, tiap produk punya datanya sendiri"</em></p>
      <p>Bayangkan <strong>rak berisi beberapa kardus</strong>. Setiap kardus adalah <strong>array asosiatif</strong>.</p>
      <pre>&lt;?php
$daftar = [
  [ "kode" => "P01", "nama" => "Mie Instan", "harga" => 3500 ],
  [ "kode" => "P02", "nama" => "Teh Botol",  "harga" => 4000 ],
  [ "kode" => "P03", "nama" => "Roti",       "harga" => 5000 ],
];
?&gt;</pre>
      
      <p><strong>Langkah-langkah akses (BACA DARI LUAR KE DALAM)</strong></p>
      <pre>&lt;?php
// Cara 1: pecah jadi 2 langkah (lebih mudah dipahami)
$kardus = $daftar[0];
echo $kardus["nama"];  // Mie Instan

// Cara 2: disingkat langsung
echo $daftar[0]["nama"]; // Mie Instan
echo $daftar[2]["harga"]; // 5000
?&gt;</pre>

      <p><strong>Hasil praktik:</strong></p>
      <table>
        <tr><th>Kode</th><th>Nama Produk</th><th>Harga</th></tr>
        <?php
        $daftar = [
          [ "kode" => "P01", "nama" => "Mie Instan", "harga" => 3500 ],
          [ "kode" => "P02", "nama" => "Teh Botol",  "harga" => 4000 ],
          [ "kode" => "P03", "nama" => "Roti",       "harga" => 5000 ],
        ];
        echo "<tr><td>".$daftar[0]["kode"]."</td><td>".$daftar[0]["nama"]."</td><td>Rp ".number_format($daftar[0]["harga"],0,',','.')."</td></tr>";
        echo "<tr><td>".$daftar[1]["kode"]."</td><td>".$daftar[1]["nama"]."</td><td>Rp ".number_format($daftar[1]["harga"],0,',','.')."</td></tr>";
        echo "<tr><td>".$daftar[2]["kode"]."</td><td>".$daftar[2]["nama"]."</td><td>Rp ".number_format($daftar[2]["harga"],0,',','.')."</td></tr>";
        ?>
      </table>

      <div class="task" style="margin-top:14px;">
        <h3 style="margin-top:0;">// LATIHAN CEPAT</h3>
        <ol>
          <li>Buka <code>var_dump($daftar);</code> lalu perhatikan: ada <code>[0] => array(...)</code> artinya <strong>ada array di dalam array</strong>.</li>
          <li>Coba ambil <code>$daftar[1]["nama"]</code> lalu tampilkan pakai <code>echo</code>.</li>
          <li>Tantangan: tambah 1 produk lagi ke <code>$daftar</code>, lalu tampilkan ke dalam tabel di atas.</li>
        </ol>
      </div>
    </div>

    <div class="card">
      <h2>Trik Detektif: var_dump()</h2>
      <p><code>var_dump()</code> menampilkan tipe data secara lengkap. Sangat berguna saat bingung.</p>
      <pre>&lt;?php var_dump($teks); var_dump($jumlah); var_dump($stok_ada); ?&gt;</pre>
      <p>Hasil:</p>
      <pre><?php
        var_dump($teks);
        var_dump($jumlah);
        var_dump($stok_ada);
      ?></pre>
    </div>

    <div class="task">
      <h3>// TUGAS</h3>
      <ol>
        <li>Sebelum menjalankan, tebak dulu: apa tipe data dari <code>"16"</code> (pakai tanda kutip)? Cek dengan <code>var_dump("16")</code>.</li>
        <li>Bandingkan <code>var_dump(16)</code> dan <code>var_dump("16")</code>. Apa bedanya?</li>
        <li>Tantangan: tambahkan 1 produk baru ke array <code>$produk</code>, lalu tampilkan lagi.</li>
      </ol>
    </div>
  </main>

